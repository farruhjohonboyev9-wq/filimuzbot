[Unit]
Description=Filimuz Telegram Bot Service
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/filimuz
Environment="PATH=/root/filimuz/venv/bin"
ExecStart=/root/filimuz/venv/bin/python /root/filimuz/filimuz.py
Restart=always
RestartSec=15
StandardOutput=journal
StandardError=journal
SyslogIdentifier=filimuz

[Install]
WantedBy=multi-user.target
